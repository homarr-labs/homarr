{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "homarr-custom-widget-v2"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "iconUrl": {
      "type": "string",
      "format": "uri"
    },
    "sources": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "baseUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "networkScope": {
            "type": "string",
            "enum": [
              "public",
              "private",
              "loopback"
            ]
          },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "none"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "bearer"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "basic"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "apiKeyHeader"
                  },
                  "headerName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
                  }
                },
                "required": [
                  "type",
                  "headerName"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "apiKeyQuery"
                  },
                  "parameterName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "type",
                  "parameterName"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "baseUrl",
          "networkScope",
          "auth"
        ],
        "additionalProperties": false
      }
    },
    "requests": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "query",
              "action"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH"
            ]
          },
          "pathTemplate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^\\/.*"
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "optionsBinding": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "$option": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "$option"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "queryTemplate": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "bodyTemplate": {
            "$ref": "#/$defs/__schema1"
          },
          "staticHeaders": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "auth": {
            "type": "string",
            "enum": [
              "inherit",
              "none"
            ]
          },
          "minimumBoardPermission": {
            "type": "string",
            "enum": [
              "view",
              "modify",
              "full"
            ]
          },
          "trigger": {
            "default": "manual",
            "type": "string",
            "enum": [
              "load",
              "manual"
            ]
          },
          "cacheTtlSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600
          },
          "confirmation": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "confirmLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "destructive": {
                "type": "boolean"
              }
            },
            "required": [
              "title",
              "message"
            ],
            "additionalProperties": false
          },
          "invalidates": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          }
        },
        "required": [
          "id",
          "sourceId",
          "kind",
          "method",
          "pathTemplate",
          "parameters",
          "auth",
          "minimumBoardPermission",
          "trigger"
        ],
        "additionalProperties": false
      }
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "properties": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "if": {},
        "then": {},
        "else": {}
      },
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "additionalProperties": false
    },
    "defaultOptions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    }
  },
  "required": [
    "$schema",
    "name",
    "sources",
    "requests",
    "optionsSchema",
    "defaultOptions",
    "template"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  },
  "title": "Homarr Custom JSX v2 widget",
  "description": "The only supported Homarr custom-widget format. Secrets are configured separately."
}
