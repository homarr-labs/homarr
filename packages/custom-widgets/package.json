{
  "name": "@homarr/custom-widgets",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "exports": {
    "./authoring-prompt": "./src/core/ai-prompt.ts",
    "./authoring-resources": "./src/core/authoring-resources.ts",
    "./catalog": "./src/core/catalog.ts",
    "./catalog-example": "./src/core/component-example.ts",
    "./core": "./src/core/index.ts",
    "./jsx": "./src/jsx/index.ts",
    "./jsx/analyzer": "./src/jsx/analyzer.ts",
    "./runtime": "./src/runtime/index.ts",
    "./server": "./src/server/index.ts",
    "./workbench": "./src/workbench/index.ts"
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "check:architecture": "bun ./scripts/check-architecture.mjs",
    "generate:catalog": "bun ./scripts/generate-component-metadata.ts",
    "generate:components": "bun run generate:catalog",
    "generate": "bun run generate:catalog",
    "evaluate:ai": "bun ./scripts/evaluate-ai-authoring.ts",
    "evaluate:assistant-ai": "bun ./scripts/evaluate-ai-authoring.ts --assistant",
    "test:reference-apis": "bun ./scripts/verify-reference-apis.ts",
    "format": "oxfmt .",
    "lint": "oxlint",
    "test": "bun --bun vitest run",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/theme-one-dark": "catalog:",
    "@codemirror/view": "catalog:",
    "@homarr/definitions": "workspace:^0.1.0",
    "@mantine/charts": "catalog:",
    "@mantine/core": "catalog:",
    "@mantine/dates": "catalog:",
    "@mantine/hooks": "catalog:",
    "@tabler/icons-react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "acorn": "catalog:",
    "acorn-jsx": "catalog:",
    "codemirror": "catalog:",
    "jsonpath-plus": "catalog:",
    "react": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@homarr/tsconfig": "workspace:^0.1.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-compiler-api": "npm:typescript@6.0.2",
    "vitest": "catalog:"
  }
}
