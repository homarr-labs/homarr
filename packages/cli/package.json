{
  "name": "@homarr/cli",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --format=cjs --outfile=cli.cjs --external=bcrypt --external=cpu-features",
    "clean": "rm -rf .turbo node_modules",
    "format": "oxfmt .",
    "lint": "oxlint",
    "run": "bun run with-env bun cli.cjs",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "@drizzle-team/brocli": "catalog:",
    "@homarr/auth": "workspace:^0.1.0",
    "@homarr/common": "workspace:^0.1.0",
    "@homarr/db": "workspace:^0.1.0",
    "@homarr/validation": "workspace:^0.1.0",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@homarr/tsconfig": "workspace:^0.1.0",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}
