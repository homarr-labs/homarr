{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["bun", "node"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["./**/*.ts"]
}
