{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "$TURBO_EXTENDS$",
        "SKIP_ENV_VALIDATION",
        "NEXT_DEPLOYMENT_ID",
        "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
        "HOMARR_WEBSITE_URL",
        "WORKSHOP_API_URL",
        "WORKSHOP_WEB_URL",
        "KAPA_WEBSITE_ID",
        "WORKSHOP_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/__tests__/**",
        "!README.md",
        "!AGENTS.md",
        "!PRODUCT.md",
        "$TURBO_ROOT$/packages/definitions/src/docs/**",
        "$TURBO_ROOT$/tools/motion-reel/three/**",
        ".env*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**", "next-env.d.ts", ".source/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/motion-reel/three/**"]
    },
    "topo": {
      "inputs": ["$TURBO_DEFAULT$"]
    }
  }
}
