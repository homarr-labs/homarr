{
  "name": "@homarr/docs",
  "version": "0.2.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev --port 3003",
    "start": "bun --bun serve out --listen 3003 --config ../serve.json",
    "build": "bun run validate:coverage && bun --bun next build",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "clean": "git clean -xdf .next out node_modules",
    "api-dump-contributors": "bun ./scripts/dump-contributors.mjs",
    "validate:coverage": "bun ./scripts/validate-docs-coverage.ts",
    "validate:links": "bun ./scripts/validate-links.ts",
    "verify:search": "bun ./scripts/verify-search.ts",
    "verify:seo": "bun ./scripts/verify-seo.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@homarr/custom-widgets": "workspace:^",
    "@homarr/definitions": "workspace:^",
    "@homarr/ui": "workspace:^",
    "@homarr/workshop": "workspace:^",
    "@mantine/core": "catalog:",
    "@mdx-js/react": "^3.1.1",
    "@nivo/line": "^0.99.0",
