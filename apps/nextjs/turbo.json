{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["build:dependencies"],
      "env": ["$TURBO_EXTENDS$", "HOMARR_FRONTEND_MODE", "HOMARR_PLATFORM_PATH"],
      "cache": false,
      "outputs": [".output/standalone/**"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/static-data/**",
        ".env*",
        "$TURBO_ROOT$/.env*"
      ]
    },
    "typecheck": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/static-data/**"]
    },
    "build:compiled": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/static-data/**",
        ".env*",
        "$TURBO_ROOT$/.env*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "!.next/standalone/**", "next-env.d.ts"],
      "dependsOn": ["^build"],
      "env": [
        "SKIP_ENV_VALIDATION",
        "TURBO_PLATFORM",
        "NEXT_DEPLOYMENT_ID",
        "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
        "HOMARR_FRONTEND_MODE",
        "HOMARR_PLATFORM_PATH"
      ],
      "passThroughEnv": ["NEXT_TELEMETRY_DISABLED"]
    },
    "build:dependencies": {
      "dependsOn": ["build:compiled"],
      "env": ["TURBO_PLATFORM", "HOMARR_FRONTEND_MODE", "HOMARR_PLATFORM_PATH"],
      "inputs": [
        "package.json",
        "scripts/cache-standalone.mjs",
        "scripts/standalone-artifact.mjs",
        {
          "mode": "dependencyOutputs",
          "from": ["build:compiled"],
          "globs": [".next/standalone-dependencies.json"]
        }
      ],
      "outputs": [".output/dependencies/**"]
    }
  }
}
