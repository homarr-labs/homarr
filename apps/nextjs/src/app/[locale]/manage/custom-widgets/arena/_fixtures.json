  {
    "id": "event-feed",
    "title": "Activity feed",
    "prompt": "Display QueueItemDeleted, SearchTriggered and removal activity newest-first with event name, description, category/status, timestamp and relative age using the frozen response now value (not Date.now). Include filter Select bind=category with all/queue/search/removal choices and manual SubFetch requestId=filteredEvents params={{category: inputs.category ?? 'all'}}; render its {events:[...],now} result. Keep full initial feed, manual filter and every query state.",
    "definition": {
      "$schema": "homarr-custom-widget-v2",
      "name": "Activity feed",
      "description": "Synthetic arena fixture; all requests and controls are simulated.",
      "sources": {
        "default": {
          "name": "Arena fixture",
          "baseUrl": "https://arena.example.com",
          "auth": "none"
        }
      },
      "requests": {
        "events": {
          "source": "default",
          "kind": "query",
          "method": "GET",
          "path": "/fixtures/events",
          "auth": "inherit",
          "trigger": "load",
          "permission": "view"
        },
        "filteredEvents": {
          "source": "default",
          "kind": "query",
          "method": "GET",
          "path": "/fixtures/events/filter",
          "trigger": "manual",
          "query": {
            "category": {
              "$param": "category"
            }
          },
          "auth": "inherit",
          "permission": "view"
        }
      },
      "options": {},
      "template": "<Stack p=\"md\"><Text>Activity feed</Text><Text>Synthetic fixture simulation</Text></Stack>"
    },
    "responses": {
