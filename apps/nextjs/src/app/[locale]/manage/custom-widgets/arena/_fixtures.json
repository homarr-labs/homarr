    "prompt": "Render November 2026 as a Monday-first month grid including weekday labels, numbered dates and readable event NAMES in their cells, not dots alone. Today is November 2 from the frozen clock. Synthetic JSON adaptation, NOT iCal parsing. data.calendar.days supplies all 42 grid cells (including adjacent months) and per-day event lists. Handle no events distinctly from loading/error and preserve month context.",
    "definition": {
      "$schema": "homarr-custom-widget-v2",
      "name": "November calendar",
      "description": "Synthetic arena fixture; all requests and controls are simulated.",
      "sources": {
        "default": {
          "name": "Arena fixture",
          "baseUrl": "https://arena.example.com",
          "auth": "none"
        }
      },
      "requests": {
        "calendar": {
          "source": "default",
          "kind": "query",
          "method": "GET",
          "path": "/fixtures/calendar",
          "query": {
            "month": {
              "$option": "month"
            }
          },
          "auth": "inherit",
          "trigger": "load",
          "permission": "view"
        }
      },
      "options": {
        "month": {
          "label": "Month",
          "control": "text",
          "default": "2026-11"
        }
      },
      "template": "<Stack p=\"md\"><Text>November calendar</Text><Text>Synthetic fixture simulation</Text></Stack>"
    },
