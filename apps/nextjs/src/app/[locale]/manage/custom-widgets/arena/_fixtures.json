[
  {
    "id": "ntfy",
    "title": "Notifications",
    "prompt": "Show newest-first notifications filtered by configured topic. Include title, message, priority, timestamp, local placeholder images and each action label. Invoke notificationAction with id and actionId through a confirmed ActionButton; never follow external links. Keep refresh and all query states.",
    "definition": {
      "$schema": "homarr-custom-widget-v2",
      "name": "Notifications",
      "description": "Synthetic arena fixture; all requests and controls are simulated.",
      "sources": {
        "default": {
          "name": "Arena fixture",
          "baseUrl": "https://arena.example.com",
          "auth": "none"
        }
      },
      "requests": {
        "notifications": {
          "source": "default",
          "kind": "query",
          "method": "GET",
          "path": "/fixtures/notifications",
          "query": {
            "topic": {
              "$option": "topic"
            }
          },
          "auth": "inherit",
          "trigger": "load",
          "permission": "view"
        },
        "notificationAction": {
          "source": "default",
          "kind": "action",
          "method": "POST",
          "path": "/fixtures/notifications/{param:id}/actions/{param:actionId}",
          "auth": "inherit",
          "confirmation": "Simulate this notification action?",
          "invalidates": [
            "notifications"
          ],
          "trigger": "manual",
          "permission": "modify"
        }
      },
      "options": {
        "topic": {
          "label": "Topic",
          "control": "text",
          "default": "homelab"
        }
      },
      "template": "<Stack p=\"md\"><Text>Notifications</Text><Text>Synthetic fixture simulation</Text></Stack>"
    },
    "responses": {
      "notifications": {
        "messages": [
          {
            "id": "n3",
            "topic": "homelab",
            "title": "Backup completed",
            "message": "Nightly archive verified.",
            "priority": 3,
            "time": "2026-11-02T11:58:00Z",
            "image": "/images/demo-dashboard-background.svg",
            "actions": [
              {
                "id": "ack",
                "label": "Acknowledge"
              }
            ]
          },
          {
            "id": "n2",
            "topic": "homelab",
            "title": "Front gate",
            "message": "Parcel detected.",
            "priority": 4,
            "time": "2026-11-02T11:42:00Z",
            "image": "/images/demo-dashboard-background.svg",
            "actions": [
              {
                "id": "dismiss",
                "label": "Dismiss"
              }
            ]
          },
          {
            "id": "n1",
            "topic": "homelab",
            "title": "Maintenance",
            "message": "Storage check scheduled.",
            "priority": 2,
            "time": "2026-11-02T10:00:00Z",
            "actions": []
          }
        ]
      },
      "notificationAction": {
        "accepted": true,
        "message": "Simulated acknowledgement"
      }
    },
    "emptyResponses": {
      "notifications": {
        "messages": []
      },
      "notificationAction": {
        "accepted": true
      }
    },
    "manualParams": {
      "notificationAction": {
        "id": "n3",
        "actionId": "ack"
      }
    },
    "defaultOptions": {
      "topic": "homelab"
