{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["bun", "vite/client", "nitro/vite/types"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "server", "scripts/container", "vite.config.ts", "nitro.config.ts"]
}
