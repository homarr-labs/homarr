{
  "name": "homarr",
  "version": "1.74.0",
  "private": true,
  "scripts": {
    "build": "cross-env CI=true turbo build",
    "benchmark:build:docker": "node --experimental-strip-types scripts/benchmarks/docker-build.mts",
    "benchmark:compare": "node --experimental-strip-types scripts/benchmarks/benchmark-compare.mts",
    "benchmark:board-graph": "node --experimental-strip-types scripts/benchmarks/board-static-graph.mts",
    "benchmark:docker": "node --experimental-strip-types scripts/benchmarks/docker-runtime.mts",
    "benchmark:request-memory": "node --expose-gc --import tsx scripts/benchmarks/request-handler-memory.mts",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "check:custom-widgets": "pnpm --filter @homarr/custom-widgets check:architecture",
    "check:custom-widget-bundle": "node ./scripts/check-custom-widget-bundle.mjs",
    "check:openapi": "tsx ./scripts/check-openapi-schema.mts",
    "ci:act:all": "bash scripts/ci/act.sh all",
    "ci:act:cleanup": "bash scripts/ci/act.sh cleanup",
    "ci:act:docker": "bash scripts/ci/act.sh docker",
    "ci:act:fast": "bash scripts/ci/act.sh fast",
    "cli": "pnpm with-env tsx packages/cli/index.ts",
    "db:migration:mysql:generate": "pnpm -F db migration:mysql:generate",
    "db:migration:mysql:run": "pnpm -F db migration:mysql:run",
    "db:migration:postgresql:generate": "pnpm -F db migration:postgresql:generate",
    "db:migration:postgresql:run": "pnpm -F db migration:postgresql:run",
    "db:migration:sqlite:generate": "pnpm -F db migration:sqlite:generate",
    "db:migration:sqlite:run": "pnpm -F db migration:sqlite:run",
    "db:seed": "pnpm -F db seed",
    "db:push": "pnpm -F db push:sqlite",
    "db:studio": "pnpm -F db studio",
    "dev": "pnpm -F nextjs dev",
    "dev:benchmark": "node --experimental-strip-types scripts/benchmarks/dev-board.mts",
    "dev:cli": "go -C tools/homarr-dev run -buildvcs=false .",
    "dev:cli:build": "go -C tools/homarr-dev build -buildvcs=false .",
    "dev:cli:install": "go -C tools/homarr-dev install -buildvcs=false .",
    "dev:docs": "pnpm -F @homarr/docs dev",
    "docker:docs": "docker compose -f apps/workshop/docker-compose.yml up --build docs",
    "docker:workshop": "docker compose -f apps/workshop/docker-compose.yml up --build workshop",
    "docker:dev": "docker compose -f ./development/development.docker-compose.yml up",
    "docker:dev:up": "docker compose -f ./development/development.docker-compose.yml up -d redis",
    "format": "turbo format --continue -- --check",
    "format:fix": "turbo format --continue",
    "lint": "turbo lint --continue",
    "lint:fix": "turbo lint --continue -- --fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "release": "semantic-release",
    "scripts:update-bug-report-template": "tsx ./scripts/update-bug-report-template.mts",
    "scripts:update-readme-integrations": "tsx ./scripts/update-integration-list.mts",
    "start": "pnpm -F nextjs start",
    "test": "cross-env NODE_ENV=development CI=true vitest run --project \"!e2e\" --retry 2 --coverage.enabled ",
    "test:e2e": "cross-env NODE_ENV=development CI=true vitest e2e --retry 2 --maxWorkers 2",
    "test:workshop": "sh apps/workshop/test.sh",
    "test:workshop-live-provider": "node apps/workshop/tests/openrouter-live-smoke.mjs",
    "test:workshop-image": "sh apps/workshop/test-image.sh",
    "test:ui": "cross-env NODE_ENV=development CI=true vitest --project \"!e2e\" --ui --coverage.enabled",
    "typecheck": "turbo typecheck",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "jsonpath-plus": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@playwright/test": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/git": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/npm": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@testcontainers/redis": "catalog:",
    "@turbo/gen": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "cross-env": "catalog:",
    "jsdom": "catalog:",
    "json5": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "semantic-release": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.15.1"
  },
  "packageManager": "pnpm@11.15.1"
}
