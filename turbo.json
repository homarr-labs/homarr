{
  "$schema": "https://turborepo.org/schema.json",
  "remoteCache": {
    "signature": true
  },
  "globalEnv": ["CI", "NODE_ENV", "SKIP_ENV_VALIDATION"],
  "ui": "stream",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["TURBO_PLATFORM"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/__tests__/**",
        "!**/*.md",
        "!**/*.mdx",
        "!**/README*",
        "!**/CHANGELOG*",
        "!**/LICENSE*",
        "!**/*.stories.{ts,tsx}"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "next-env.d.ts",
        ".output/**",
        ".vercel/output/**",
        "build/**"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "format": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"],
      "outputLogs": "new-only"
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "agentGuidance": false
}
