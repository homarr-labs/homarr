{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "endOfLine": "lf",
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/*.cjs",
    "**/lang/**",
    "static-data/**",
    "CHANGELOG.md",
    "apps/docs/.next/**",
    "apps/docs/out/**",
    "apps/docs/blog/2022/**",
    "apps/docs/blog/2023/**",
    "apps/docs/blog/2024/**",
    "apps/docs/blog/2025/**",
    "apps/docs/blog/authors.yml",
    "apps/docs/public/api/open-api-schema.json",
    "packages/custom-widgets/src/core/component-catalog.generated.json",
    "apps/docs/public/custom-widgets/component-catalog-v1.json"
  ]
}
