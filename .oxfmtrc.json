{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "endOfLine": "lf",
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/*.cjs",
    "**/lang/**",
    "static-data/**",
    "CHANGELOG.md",
    "apps/docs/.docusaurus/**",
    "apps/docs/build/**",
    "apps/docs/blog/**",
    "packages/custom-widgets/src/core/component-catalog.generated.json",
    "packages/custom-widgets/src/core/component-runtime.generated.json",
    "apps/docs/static/custom-widgets/component-catalog-v1.json"
  ]
}
