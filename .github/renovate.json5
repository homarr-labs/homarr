{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboardApproval"],
  packageRules: [
    {
      matchPackageNames: ["^@homarr/"],
      enabled: false,
    },
    // Reenable once bug with undici v8 is fixed (https://github.com/homarr-labs/homarr/issues/5467)
    {
      matchPackageNames: ["undici"],
      matchNewValue: "8.*",
      enabled: false,
    },
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      // disallow automerge for trustedDependencies (native builds need manual verification)
      matchPackageNames: [
        "@tree-sitter-grammars/tree-sitter-yaml",
        "bcrypt",
        "cpu-features",
        "esbuild",
        "sharp",
        "ssh2",
        "tree-sitter",
        "tree-sitter-json",
      ],
      automerge: false,
    },
  ],
  updateInternalDeps: true,
  rangeStrategy: "bump",
  automerge: false,
  baseBranchPatterns: ["dev"],
  dependencyDashboard: true,
  // prevent special characters in branch names (otherwise git errors occur on windows)
  branchNameStrict: true,
}
