{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
  ],
  packageRules: [
    {
      matchPackageNames: ["@tabler/icons-react", "@tabler/icons-sprite"],
      groupName: "Tabler icons",
    },
    {
      matchPackageNames: ["^@homarr/"],
      enabled: false,
    },
    // Reenable once bug with undici v8 is fixed (https://github.com/homarr-labs/homarr/issues/5467)
    {
      matchPackageNames: ["undici"],
      matchNewValue: "8.*",
      enabled: false,
    },
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      // workflow changes run with repository secrets, so they need a human review and a release age cooldown
      matchManagers: ["github-actions"],
      minimumReleaseAge: "3 days",
      internalChecksFilter: "strict",
      automerge: false,
    },
    {
      // disallow automerge for trustedDependencies (native builds need manual verification)
      matchPackageNames: [
        "bcrypt",
        "better-sqlite3",
        "cpu-features",
        "esbuild",
        "sharp",
        "ssh2",
      ],
      automerge: false,
    },
  ],
  updateInternalDeps: true,
  rangeStrategy: "bump",
  automerge: false,
  baseBranchPatterns: ["dev"],
  dependencyDashboard: true,
  // prevent special characters in branch names (otherwise git errors occur on windows)
  branchNameStrict: true,
}
