  "title": "feat(boards): add keyboard shortcuts for board switching",
  "user": {
    "login": "ajnart",
    "id": 49837342,
    "node_id": "MDQ6VXNlcjQ5ODM3MzQy",
    "avatar_url": "https://avatars.githubusercontent.com/u/49837342?v=4",
