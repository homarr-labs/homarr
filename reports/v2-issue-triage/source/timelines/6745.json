          "url": "https://api.github.com/repos/homarr-labs/homarr/pulls/6749",
          "html_url": "https://github.com/homarr-labs/homarr/pull/6749",
          "diff_url": "https://github.com/homarr-labs/homarr/pull/6749.diff",
