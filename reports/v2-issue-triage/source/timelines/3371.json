        "pull_request": {
          "url": "https://api.github.com/repos/homarr-labs/homarr/pulls/6139",
          "html_url": "https://github.com/homarr-labs/homarr/pull/6139",
          "diff_url": "https://github.com/homarr-labs/homarr/pull/6139.diff",
          "patch_url": "https://github.com/homarr-labs/homarr/pull/6139.patch",
