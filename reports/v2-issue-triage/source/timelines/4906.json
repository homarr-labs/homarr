      "gists_url": "https://api.github.com/users/tkodev/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/tkodev/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/tkodev/subscriptions",
      "organizations_url": "https://api.github.com/users/tkodev/orgs",
      "repos_url": "https://api.github.com/users/tkodev/repos",
      "events_url": "https://api.github.com/users/tkodev/events{/privacy}",
