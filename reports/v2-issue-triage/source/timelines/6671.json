        "pull_request": {
          "url": "https://api.github.com/repos/homarr-labs/homarr/pulls/6674",
          "html_url": "https://github.com/homarr-labs/homarr/pull/6674",
          "diff_url": "https://github.com/homarr-labs/homarr/pull/6674.diff",
          "patch_url": "https://github.com/homarr-labs/homarr/pull/6674.patch",
          "merged_at": null
