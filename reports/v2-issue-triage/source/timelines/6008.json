        "pull_request": {
          "url": "https://api.github.com/repos/homarr-labs/homarr/pulls/6009",
          "html_url": "https://github.com/homarr-labs/homarr/pull/6009",
          "diff_url": "https://github.com/homarr-labs/homarr/pull/6009.diff",
