{
  auto_https off
  servers {
    protocols h1 h2
  }
}

https://homarr.test {
  tls /certs/server.crt /certs/server.key
  log {
    output stdout
    format json
  }
  reverse_proxy homarr:7575
}

https://other.test {
  tls /certs/server.crt /certs/server.key
  log {
    output stdout
    format json
  }
  reverse_proxy ws-site:8080
}
