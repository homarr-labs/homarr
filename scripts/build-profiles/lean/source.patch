+import { access, readFile } from "node:fs/promises";
+import path from "node:path";
+
+import type { TranslationObject } from "./type";
+import type { SupportedLanguage } from "./languages";
+import { supportedLanguages } from "./languages";
+
+const isSupportedLanguage = (locale: string): locale is SupportedLanguage =>
+  supportedLanguages.includes(locale as SupportedLanguage);
+
+const catalogDirectoryCandidates = [
+  path.resolve(process.cwd(), "packages/translation/src/lang"),
+  path.resolve(process.cwd(), "../../packages/translation/src/lang"),
+];
+
+// Keep only the resolved directory string process-wide; catalog objects remain request-local.
+let resolvedCatalogDirectory: string | undefined;
+
+const getCatalogDirectoryAsync = async () => {
+  if (resolvedCatalogDirectory) return resolvedCatalogDirectory;
+
+  for (const candidate of catalogDirectoryCandidates) {
+    try {
+      await access(path.join(candidate, "en.json"));
+      resolvedCatalogDirectory = candidate;
+      return candidate;
+    } catch {
+      // Try the next fixed application-root-relative location.
+    }
+  }
+
+  throw new Error("Unable to locate the supported locale catalog directory");
+};
+
+export const readCatalogAsync = async (locale: SupportedLanguage): Promise<TranslationObject> => {
+  if (!isSupportedLanguage(locale)) {
+    throw new Error("Cannot read a catalog for an unsupported locale");
+  }
+
+  const filePath = path.join(await getCatalogDirectoryAsync(), `${locale}.json`);
+  const contents = await readFile(filePath, "utf8");
+  return JSON.parse(contents) as TranslationObject;
+};
